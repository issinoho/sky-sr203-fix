# Copy to .env and adjust if needed:  cp .env.example .env
#
# Host port to publish the proxy on (browse to http://<docker-host>:PROXY_PORT/)
PROXY_PORT=8099
# The Sky Hub SR203 address the proxy forwards to.
ROUTER_ADDR=192.168.0.1:80
# Stamp the freshest session token onto saves (leave on).
FIX_SESSIONKEY=1
# Auto-resubmit a save that still returns "Session expired" (leave on).
RETRY_EXPIRED=1
# Set to 1 to log per-request token decisions to the container logs (diagnostics).
DEBUG=0

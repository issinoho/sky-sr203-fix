[Unit]
Description=Sky SR203 web-UI fix proxy (repairs HTTP/0.9 replies + sessionKey race)
Documentation=https://github.com/issinoho/sky-sr203-fix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Where you cloned the repo (edit to match):
WorkingDirectory=/opt/sky-sr203-fix
ExecStart=/usr/bin/python3 -I /opt/sky-sr203-fix/sr203-proxy.py
# Config — edit to taste:
Environment=SR203_LISTEN=0.0.0.0:8099
Environment=SR203_TARGET=192.168.0.1:80
Environment=SR203_FIX_SESSIONKEY=1
Restart=on-failure
RestartSec=3

# Hardening — the proxy needs no privileges, no disk writes, no home access.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6
# Only needs to bind >=1024; drop all capabilities.
CapabilityBoundingSet=
# If you set SR203_LISTEN to a port below 1024, remove the line above and add:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
